# Copia este archivo a .env y llena lo que vayas a usar. Nunca subas .env al repositorio.

# Motor de razonamiento de los agentes
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
# Motor que la consola selecciona por defecto: gemini | stub | ollama
SIGMA_LLM_DEFECTO=gemini
# Modelo concreto (opcional). Gemini: gemini/gemini-2.5-flash · Ollama: sigma-qwen25 · OpenAI: gpt-4o-mini
# SIGMA_MODELO=gemini/gemini-2.5-flash

# Ollama local (opcional): habilita la opción en la consola
# OLLAMA_HOST=http://localhost:11434

# OpenAI (opcional, solo por línea de comandos: SIGMA_LLM=openai)
# OPENAI_API_KEY=sk-...

# Pausa por llamada del motor de guion fijo, para que el avance se lea en vivo (segundos)
SIGMA_STUB_PAUSA=0.9
# Ruta de la base SQLite de la bitácora
# SIGMA_DB=data/sigma.db
